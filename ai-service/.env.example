AI_PROVIDER=ollama
AI_LOG_LEVEL=INFO
AI_PROVIDER_TIMEOUT_SECONDS=240
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=false

# Optional provider. Never commit a real API key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=none

# Optional backend-only web search for recent World Cup updates.
# Requires OPENAI_API_KEY and sends only the web-search question, not the album snapshot.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=openai
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-mini
OPENAI_WEB_SEARCH_CONTEXT_SIZE=low
WEB_SEARCH_ALLOWED_DOMAINS=fifa.com
